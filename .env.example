# Copy to .env.local and fill in. Never commit .env.local.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/travelbharat
# Signs admin session cookies. At least 32 random characters, e.g. from: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
AUTH_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
